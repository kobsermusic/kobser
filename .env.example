# ──────────────────────────────────────────────
#  Kobser: copy this file to .env and edit it
# ──────────────────────────────────────────────

# Path to the music folder on the host (absolute or relative), where
# downloaded songs are saved.
MUSIC_DIR=./data/music

# Port of the kobser web app. After starting, open http://localhost:8000.
KOBSER_PORT=8000

# Port of the Navidrome admin page, which you only need once to create your
# account after the first start.
NAVIDROME_PORT=4533

# ── kobser only (you already run Navidrome) ─────────────────────────────────
#
# Set this to the address of your Navidrome and start with
#   docker compose up -d
# without --profile full, so that the bundled Navidrome stays off.
#
# NAVIDROME_URL=http://your-navidrome-host:4533

# ── Optional ────────────────────────────────────────────────────────────────

# Path to a Netscape-format cookies.txt exported from your browser, which is
# only needed for age-restricted or region-locked YouTube videos.
# YTDLP_COOKIES_FILE=./secrets/cookies.txt
